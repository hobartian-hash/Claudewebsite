{# The dark subscribe panel. One per page, at the bottom. #}
{% from "partials/subform.njk" import subform %}

{% macro cta(site, id) -%}
<section class="cta">
      <span class="eyebrow">{{ site.subscribe.eyebrow }}</span>
      <h2>{{ site.subscribe.heading }}</h2>
      <p>{{ site.subscribe.line }}</p>
      {{ subform(site, 'sub-' + id) }}
      <p class="fine">{{ site.subscribe.reassurance }}</p>
    </section>
{%- endmacro %}
