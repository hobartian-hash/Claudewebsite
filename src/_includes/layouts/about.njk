---
layout: layouts/base.njk
---
{%- from "partials/face.njk" import face -%}
{%- from "partials/cta.njk" import cta -%}

<div class="wrap">
    <section class="pagehead">
      <span class="eyebrow">About</span>
      <h1>Hello, I'm {{ site.author }}.</h1>
    </section>

    <div class="measure">
      <div class="aboutlead">
        {{ face(site, 'face') }}
        <span class="fine">{{ site.place }}<br>Writing every {{ site.publishDay }}</span>
      </div>

      <div class="prose" style="padding-top:0">
        <p>Teaching something for years doesn't stop you drifting. It mostly just makes it easier to notice.</p>
        <p>{{ site.about }}</p>
        {%- for p in site.aboutMore %}
        <p>{{ p }}</p>
        {%- endfor %}

        <h2>What I write about</h2>
        <p><strong>Work</strong> — clients, projects, and the risks that were never really about the software.</p>
        <p><strong>Coaching</strong> — building the person beside you, and the conversations that get avoided.</p>
        <p><strong>Career</strong> — strengths, blind spots, and the decisions you only understand years later.</p>
        <p><strong>Fathering</strong> — what gets handed on, deliberately or not.</p>
        <p><strong>Off the Clock</strong> — attention, energy, the life around the work.</p>

        <p><a class="backlink" href="/archive/">Read the archive &rarr;</a></p>
      </div>
    </div>

    {{ cta(site, 'about') }}
  </div>
