---
layout: layouts/base.njk
---
{%- from "partials/face.njk" import face -%}
{%- from "partials/cta.njk" import cta -%}
{%- from "partials/row.njk" import row -%}
{%- from "partials/lead.njk" import lead -%}
{%- set newest = essays[0] -%}

<div class="wrap">
    {{ lead(newest, site) }}

    <div class="secline"><h2>More essays</h2><a href="/archive/">Full archive &rarr;</a></div>
    <section class="index">
      {%- for e in essays.slice(1, 5) %}
      {{ row(e, site) }}
      {%- endfor %}
    </section>

    <div class="secline"><h2>About {{ site.author }}</h2><a href="/about/">Read more &rarr;</a></div>
    <section class="aboutstrip">
      {{ face(site, 'face') }}
      <div class="t">
        <p class="motto">{{ site.motto | safe }}</p>
        <p>{{ site.about }}</p>
        <a class="backlink" style="margin:0" href="/about/">More about me &rarr;</a>
      </div>
    </section>

    {{ cta(site, 'home') }}
  </div>
