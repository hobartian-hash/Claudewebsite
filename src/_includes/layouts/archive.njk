---
layout: layouts/base.njk
---
{%- from "partials/cta.njk" import cta -%}
{%- from "partials/row.njk" import row -%}
{%- set list = essays -%}

<div class="wrap">
    <section class="pagehead">
      <span class="eyebrow">{{ essays.length }} issues &middot; published {{ site.publishDay }}s</span>
      <h1>The archive</h1>
      <p>Everything so far, newest first.</p>
    </section>

    <section class="index">
      {%- for e in list %}
      {{ row(e, site) }}
      {%- endfor %}
    </section>

    {{ cta(site, 'arch') }}
  </div>
