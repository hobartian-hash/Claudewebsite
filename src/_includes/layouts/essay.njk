---
layout: layouts/base.njk
---
{%- from "partials/cta.njk" import cta -%}
{%- from "partials/row.njk" import row -%}

<article>
    <div class="wrap">
      <div class="measure essayhead">
        <h1>{{ essay.title }}</h1>
        <div class="byline">
          <span>By {{ site.author }}</span><i>&middot;</i>
          <span>{{ essay.date | fmtDate }}</span><i>&middot;</i>
          <span>{{ essay.readTime }} min read</span><i>&middot;</i>
          <span>Issue No.&nbsp;{{ essay.number | pad }}</span>
        </div>
        <div class="headrule"></div>
      </div>

      {#- The drop cap comes from .prose > p:first-of-type, so the rendered
          body has to be a direct child here. Website only — the email
          deliberately has none. -#}
      <div class="measure prose">
        {{ essay.body | safe }}
        <p class="signoff">{{ site.signoff }} {{ site.author }}</p>
        <p class="follow">If this was useful, forward it on, or <a href="{{ site.baseUrl }}{{ page.url }}" class="copylink" data-url="{{ site.baseUrl }}{{ page.url }}" data-label="copy the link">copy the link</a>.</p>
      </div>
    </div>

    <div class="wrap">
      <div class="secline"><h2>Read next</h2><a href="/archive/">Full archive &rarr;</a></div>
      <section class="index">
        {%- for e in essays | related(essay) %}
        {{ row(e, site) }}
        {%- endfor %}
      </section>
      <p><a class="backlink" href="/archive/">&larr; Back to the archive</a></p>
      {{ cta(site, 'essay') }}
    </div>
  </article>
