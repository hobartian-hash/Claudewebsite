{% if site.hideFromSearch -%}
# Pre-launch. Sends a "don't list this" instruction with every page, which is
# the belt to the meta tag's braces — it also covers anything that isn't a web
# page. Switch it off by setting "hideFromSearch" to false in content/site.json.
/*
  X-Robots-Tag: noindex, nofollow
{% endif -%}
# The welcome page only makes sense arriving from the confirmation email, so it
# stays out of search results even after the rest of the site goes in.
/welcome/*
  X-Robots-Tag: noindex, nofollow
